# --- Database ---
# Add ?sslmode=verify-full for any database not on localhost. Neon and most
# managed hosts require TLS anyway, but stating it means the app refuses an
# unencrypted connection rather than silently accepting one if the host stops
# insisting. 'require' also works and is what most providers hand you; it is
# treated as verify-full by the current driver, and will mean something weaker
# in pg v9, so prefer the explicit form.
DATABASE_URL="postgresql://user:password@localhost:5432/examwala"

# --- Auth ---
# Replace in every real environment. Generate with: openssl rand -base64 48
AUTH_SECRET=""   # REQUIRED: openssl rand -base64 48
AUTH_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TTL_SECONDS="2592000"

# --- Google OAuth (optional; login falls back to email+password when unset) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# --- AI provider ---
# Leave ANTHROPIC_API_KEY empty to run on the deterministic offline provider.
# The app is fully usable without a key; responses are then rule-generated
# and labelled as such in the UI.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-5"
AI_FREE_DAILY_MESSAGE_LIMIT="15"
AI_PREMIUM_DAILY_MESSAGE_LIMIT="500"

# --- Storage ---
# Local disk for development. Swap for S3-compatible storage in production.
# 'postgres' keeps uploaded files in the database beside their metadata row.
# It needs nothing configuring and is the only option that works on a serverless
# host, where 'local' writes to a filesystem that is thrown away between
# requests — so 'local' is refused there rather than losing files quietly.
STORAGE_DRIVER="postgres"
STORAGE_LOCAL_DIR="./.storage"
MAX_UPLOAD_BYTES="10485760"

# --- App ---
# Scheduled tasks. Generate with: openssl rand -base64 32
# Unset means /api/cron/tick refuses every request, so reminders never send.
# On Vercel, setting this also makes Vercel Cron authenticate itself.
CRON_SECRET=""

APP_URL="http://localhost:3000"
DEFAULT_COUNTRY="IN"
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# --- Proxy ---
# Number of trusted reverse proxies in front of the app. 0 (the default) means
# X-Forwarded-For is ignored entirely, because an untrusted header must not be
# allowed to rotate past rate limits. Set to 1 behind a single load balancer.
TRUST_PROXY=0
